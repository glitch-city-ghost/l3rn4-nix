{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "source": "nixos",
    "color": {
      "1": "#FF0055", // Кислотно-розовый
      "2": "#76C1FF"  // Холодный синий
    },
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": "   ",
    "color": {
      "keys": "#FF0055",   // Заголовки - розовые
      "output": "#EEFFFF"  // Значения - ледяные белые (как идентификаторы в Vim)
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#FF0055", // Пользователь - розовый
        "host": "#d57bff"  // Хост - фиолетовый
      }
    },
    {
      "type": "separator",
      "string": "──────────────────────────────",
      "color": "#FF0055"
    },
    "os",
    "kernel",
    "uptime",
    "shell",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    {
      "type": "command",
      "key": "Disk (/)",
      "text": "~/l3rn4-nix/scripts/disk-usage.sh",
      "format": "{result}"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "block": true,
      "paddingLeft": 2,
      "colors": [
        "#120b10", // black
        "#ff3270", // red
        "#00FF9C", // green (только для палитры внизу)
        "#fffc58", // yellow
        "#76C1FF", // blue
        "#d57bff", // magenta
        "#00FFC8", // cyan
        "#EEFFFF"  // white
      ]
    }
  ]
}
