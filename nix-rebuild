#!/usr/bin/env bash
set -euo pipefail

# Переходим в директорию, где лежит сам скрипт
cd "$(dirname "$(readlink -f "$0")")"

# Загружаем переменные из .env, если файл существует
if [ -f .env ]; then
  set -a
  source .env
  set +a
fi

# Добавляем все изменения, чтобы flake их увидел
git add -u

# Пересобираем систему. 
# --impure нужен, чтобы Nix увидел переменные окружения.
# --preserve-env говорит sudo не стирать наши переменные.
exec sudo --preserve-env=GIT_USER_NAME,GIT_USER_EMAIL nixos-rebuild "${1:-switch}" --flake .#nixos --impure
