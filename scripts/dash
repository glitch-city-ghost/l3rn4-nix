#!/usr/bin/env bash
# ==========================================================
# l3rn4 :: dash
# tmux dashboard for the Hydra environment.
#
# The layout and every pane command come from dash.conf:
#   ~/.config/l3rn4/dash.conf   user copy (wins)
#   <repo>/dash.conf            packaged default
#
#   dash              attach or create
#   dash grid         attach or create with equal tiles
#   dash init         copy the default config to ~/.config/l3rn4
#   dash config       show the config and panes in use
#   dash kill         stop and remove the session
#   dash help
# ----------------------------------------------------------
# The tmux server lives on its own socket (-L l3rn4), so normal
# tmux sessions and ~/.config/tmux are not touched.
# ==========================================================
set -euo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
SELF_DIR=$(dirname "$SELF")
TMUX_BIN=${TMUX_BIN:-tmux}
USER_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/l3rn4/dash.conf"

usage() {
  cat <<'EOF'
l3rn4 :: dash

Usage:
  dash            attach or create the dashboard
  dash grid       same, but override the layout with equal tiles
  dash init       copy the packaged config to ~/.config/l3rn4/dash.conf
  dash config     show the config and panes in use
  dash kill       stop the dashboard
  dash help       this text

Config:
  ~/.config/l3rn4/dash.conf   user copy (wins)
  <repo>/dash.conf            packaged default
  DASH_CONFIG=/path           use another file

Every pane is one line in dash.conf:
  pane "logs" -- journalctl -fu mihomo -o short-iso

Layouts: main, main-horizontal, grid, horizontal, vertical.
Keys: <prefix> arrows, <prefix> z zoom, <prefix> d detach.
EOF
}

die() {
  printf '\e[38;2;255;50;112mdash: %s\e[0m\n' "$*" >&2
  exit 1
}

# ---------------- internal pane launcher ----------------
if [[ ${1:-} == __aux ]]; then
  shift
  label=${1:-pane}
  shift || true
  label=${label//[^[:alnum:]_-]/}
  SHELL_BIN=${DASH_FALLBACK_SHELL:-bash}
  PS1="\[\e[38;2;255;0;85m\][${label}]\[\e[0m\] \[\e[38;2;0;255;200m\]\w\[\e[0m\] ❯ "
  export PS1
  if (($#)); then
    rc=0
    "$@" || rc=$?
    if ((rc != 0)); then
      printf '\n\e[38;2;255;50;112m[%s] exited with %d\e[0m\n' "$label" "$rc"
    fi
  fi
  printf '\e[38;2;103;102;179m[dash] %s finished; dropping to a shell. detach: %s d\e[0m\n' \
    "$label" "${DASH_PREFIX:-C-b}"
  exec "$SHELL_BIN" --noprofile --norc -i
fi

# ---------------- config discovery ----------------
default_config() {
  if [[ -n ${DASH_DEFAULT_CONFIG:-} && -f $DASH_DEFAULT_CONFIG ]]; then
    printf '%s' "$DASH_DEFAULT_CONFIG"
    return 0
  fi
  if [[ -f $SELF_DIR/../dash.conf ]]; then
    printf '%s' "$(readlink -f "$SELF_DIR/../dash.conf")"
    return 0
  fi
  return 1
}

resolve_config() {
  if [[ -n ${DASH_CONFIG:-} ]]; then
    printf '%s' "$DASH_CONFIG"
    return 0
  fi
  if [[ -f $USER_CONFIG ]]; then
    printf '%s' "$USER_CONFIG"
    return 0
  fi
  default_config
}

do_init() {
  local src dest
  src=$(default_config) || die "packaged dash.conf not found"
  dest=${DASH_CONFIG:-$USER_CONFIG}
  if [[ -e $dest && $FORCE -ne 1 ]]; then
    die "$dest already exists (use: dash init --force)"
  fi
  mkdir -p "$(dirname "$dest")"
  cp "$src" "$dest"
  chmod 0644 "$dest"
  printf '\e[38;2;0;255;200mdash: wrote %s\e[0m\n' "$dest"
  printf '      edit it, then run: dash\n'
  exit 0
}

# ---------------- pane DSL ----------------
PANE_TITLES=()
PANE_CMDS=()

pane() {
  local title=${1:-pane}
  shift || true
  [[ ${1:-} == -- ]] && shift
  (($#)) || set -- "${SHELL:-bash}"

  local arg cmd=""
  for arg in "$@"; do
    printf -v arg '%q' "$arg"
    cmd+="$arg "
  done
  cmd=${cmd% }

  PANE_TITLES+=("$title")
  PANE_CMDS+=("$cmd")
}

# ---------------- command line ----------------
ACTION=attach
LAYOUT_OVERRIDE=""
FORCE=0
while (($#)); do
  case "$1" in
    attach | up | start) ACTION=attach ;;
    grid | tiles) LAYOUT_OVERRIDE=grid ;;
    kill | stop | down) ACTION="kill" ;;
    init) ACTION=init ;;
    config | where) ACTION=config ;;
    -f | --force) FORCE=1 ;;
    help | -h | --help) usage; exit 0 ;;
    *)
      printf 'dash: unknown argument: %s\n\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

case "$ACTION" in
  init) do_init ;;
esac

CONFIG=$(resolve_config) || CONFIG=""
if [[ -z $CONFIG ]]; then
  if [[ -n ${DASH_CONFIG:-} ]]; then
    die "DASH_CONFIG not found: $DASH_CONFIG"
  fi
  die "no config found; run: dash init"
fi
[[ -f $CONFIG ]] || die "config not found: $CONFIG"

# shellcheck source=/dev/null
source "$CONFIG"

# ---------------- defaults / env overrides ----------------
SESSION=${DASH_SESSION:-${dash_session:-hydra}}
SOCKET=${DASH_SOCKET:-${dash_socket:-l3rn4}}
LAYOUT=${LAYOUT_OVERRIDE:-${DASH_LAYOUT:-${dash_layout:-main}}}
MAIN_WIDTH=${DASH_MAIN_WIDTH:-${dash_main_width:-62%}}
MAIN_HEIGHT=${DASH_MAIN_HEIGHT:-${dash_main_height:-45%}}
PREFIX=${DASH_PREFIX:-${dash_prefix:-C-b}}
MOUSE=${DASH_MOUSE:-${dash_mouse:-on}}
STATUS_BAR=${DASH_STATUS:-${dash_status:-on}}
BORDERS=${DASH_BORDERS:-${dash_borders:-on}}
TERM_NAME=${DASH_TERM:-${dash_term:-tmux-256color}}
WORKDIR=${DASH_WORKDIR:-${dash_workdir:-$HOME}}
FOCUS=${DASH_FOCUS:-${dash_focus:-0}}
FALLBACK_SHELL=${DASH_FALLBACK_SHELL:-${dash_fallback_shell:-bash}}

if [[ $ACTION == config ]]; then
  printf 'config   %s\n' "$CONFIG"
  printf 'socket   %s\n' "$SOCKET"
  printf 'session  %s\n' "$SESSION"
  printf 'layout   %s\n' "$LAYOUT"
  if [[ $LAYOUT == main || $LAYOUT == main-vertical ]]; then
    printf 'size     %s wide\n' "$MAIN_WIDTH"
  elif [[ $LAYOUT == main-horizontal ]]; then
    printf 'size     %s tall\n' "$MAIN_HEIGHT"
  fi
  printf 'focus    %s\n' "$FOCUS"
  printf 'panes    %s\n' "${#PANE_TITLES[@]}"
  for i in "${!PANE_TITLES[@]}"; do
    printf '  %d  %-12s %s\n' "$i" "${PANE_TITLES[i]}" "${PANE_CMDS[i]}"
  done
  exit 0
fi

command -v "$TMUX_BIN" >/dev/null 2>&1 || die "tmux not found. Rebuild the system: ./nix-rebuild"
TM=( "$TMUX_BIN" -L "$SOCKET" )

if [[ $ACTION == kill ]]; then
  "${TM[@]}" kill-session -t "$SESSION" 2>/dev/null || true
  printf '\e[38;2;0;255;200mdash: dashboard stopped (%s)\e[0m\n' "$SOCKET"
  exit 0
fi

if [[ -n ${TMUX:-} ]]; then
  die "already inside tmux. Detach first (${PREFIX} d), then run dash from a plain terminal."
fi

if "${TM[@]}" has-session -t "$SESSION" 2>/dev/null; then
  exec "${TM[@]}" attach-session -t "$SESSION"
fi

# ---------------- validation ----------------
[[ $SESSION =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid dash_session '$SESSION'"
[[ $SOCKET =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid dash_socket '$SOCKET'"
case "$FALLBACK_SHELL" in
  bash | */bash) ;;
  *) die "dash_fallback_shell '$FALLBACK_SHELL' is not supported (use bash)" ;;
esac
FALLBACK_SHELL=$(command -v "$FALLBACK_SHELL" || command -v bash || printf 'bash')

(( ${#PANE_TITLES[@]} > 0 )) || die "no panes in $CONFIG (add: pane \"name\" command)"
(( ${#PANE_TITLES[@]} == ${#PANE_CMDS[@]} )) || die "pane table mismatch in $CONFIG"
(( ${#PANE_TITLES[@]} <= 8 )) || die "too many panes in $CONFIG (max 8)"

case "$LAYOUT" in
  main | main-vertical)
    TMUX_LAYOUT="main-vertical"
    RESIZE_OPT=-x
    RESIZE_SIZE=$MAIN_WIDTH
    ;;
  main-horizontal | top)
    TMUX_LAYOUT="main-horizontal"
    RESIZE_OPT=-y
    RESIZE_SIZE=$MAIN_HEIGHT
    ;;
  grid | tiled)
    TMUX_LAYOUT=tiled
    RESIZE_OPT=""
    RESIZE_SIZE=""
    ;;
  horizontal | columns)
    TMUX_LAYOUT=even-horizontal
    RESIZE_OPT=""
    RESIZE_SIZE=""
    ;;
  vertical | rows)
    TMUX_LAYOUT=even-vertical
    RESIZE_OPT=""
    RESIZE_SIZE=""
    ;;
  *)
    die "unknown layout '$LAYOUT' (use: main, main-horizontal, grid, horizontal, vertical)"
    ;;
esac

[[ $FOCUS =~ ^[0-9]+$ ]] || FOCUS=0
(( FOCUS < ${#PANE_TITLES[@]} )) || FOCUS=0

export DASH_PREFIX="$PREFIX"
export DASH_FALLBACK_SHELL="$FALLBACK_SHELL"

aux_cmd_for() {
  local title=$1 cmd=$2
  printf '%q __aux %q %s' "$SELF" "$title" "$cmd"
}

set_opt() {
  "${TM[@]}" set-option "$@" >/dev/null 2>&1 || true
}

set_wopt() {
  "${TM[@]}" set-window-option "$@" >/dev/null 2>&1 || true
}

# ---------------- build ----------------
BUILDING=1
cleanup_build() {
  ((BUILDING)) || return 0
  "${TM[@]}" kill-session -t "$SESSION" >/dev/null 2>&1 || true
}
trap cleanup_build ERR

main=$(
  "${TM[@]}" new-session -d -s "$SESSION" -n dash -c "$WORKDIR" \
    -P -F '#{pane_id}' "$(aux_cmd_for "${PANE_TITLES[0]}" "${PANE_CMDS[0]}")"
)

ids=("$main")
for ((i = 1; i < ${#PANE_TITLES[@]}; i++)); do
  id=$(
    "${TM[@]}" split-window -v -t "$main" -c "$WORKDIR" \
      -P -F '#{pane_id}' "$(aux_cmd_for "${PANE_TITLES[i]}" "${PANE_CMDS[i]}")"
  )
  ids+=("$id")
done

for i in "${!ids[@]}"; do
  "${TM[@]}" select-pane -t "${ids[i]}" -T "${PANE_TITLES[i]}" >/dev/null 2>&1 || true
done

"${TM[@]}" select-layout -t "$SESSION:0" "$TMUX_LAYOUT" >/dev/null 2>&1 || true
if [[ -n $RESIZE_OPT ]]; then
  "${TM[@]}" resize-pane -t "$main" "$RESIZE_OPT" "$RESIZE_SIZE" >/dev/null 2>&1 || true
fi

set_opt -s escape-time 0
set_opt -s focus-events on
set_opt -s default-terminal "$TERM_NAME"
set_opt -s history-limit 20000
set_opt -s allow-passthrough on
set_opt -sa terminal-features '*:RGB'
set_opt -t "$SESSION" mouse "$MOUSE"
set_opt -t "$SESSION" prefix "$PREFIX"
set_opt -t "$SESSION" status "$STATUS_BAR"
set_opt -t "$SESSION" status-interval 5
set_opt -t "$SESSION" status-style 'bg=#1d000a,fg=#FF0055'
set_opt -t "$SESSION" status-left " #[bold]l3rn4#[nobold] :: ${SESSION} "
set_opt -t "$SESSION" status-left-length 30
set_opt -t "$SESSION" status-right " #[fg=#6766b3]${PREFIX} d detach#[default]  %H:%M "
set_opt -t "$SESSION" status-right-length 40
set_opt -t "$SESSION" allow-rename off
set_opt -t "$SESSION" automatic-rename off
if [[ $BORDERS == on ]]; then
  set_wopt -t "$SESSION:0" pane-border-status top
else
  set_wopt -t "$SESSION:0" pane-border-status off
fi
set_wopt -t "$SESSION:0" pane-border-format ' #[bold]#{pane_title}#[nobold] '
set_wopt -t "$SESSION:0" pane-border-style 'fg=#563466'
set_wopt -t "$SESSION:0" pane-active-border-style 'fg=#FF0055'
set_wopt -t "$SESSION:0" window-status-current-style 'bg=#FF0055,fg=#120b10,bold'

"${TM[@]}" select-pane -t "${ids[FOCUS]}" >/dev/null 2>&1 || true
BUILDING=0
trap - ERR

exec "${TM[@]}" attach-session -t "$SESSION"
