{ config, pkgs, ... }:

let
  # Local generated theme from theme/palette.yaml
  # Generated by: theme/generators/generate-vim.py
  cyberpunk-vim = pkgs.vimUtils.buildVimPlugin {
    name = "cyberpunk-generated";
    src = ../../theme/generated/cyberpunk/vim;
  };
in
{
  programs.vim = {
    enable = true;
    plugins = with pkgs.vimPlugins; [
      cyberpunk-vim
      vim-airline
      vim-airline-themes
      nerdtree
    ];
    extraConfig = builtins.readFile ./vimrc;
  };
}