{ config, pkgs, ... }:

{
  programs.zsh = {
    enable = true;
    enableCompletion = true;
    autosuggestion.enable = true;
    syntaxHighlighting.enable = true;
    history.size = 10000;
    shellAliases = {
      ll = "ls -l";
    };
    initContent = ''
      cd ~
      fastfetch
    '';
  };

  programs.starship = {
    enable = true;
    enableZshIntegration = true;
    # Generated by: generators/generate-starship.py
    settings = builtins.fromTOML (
      builtins.readFile ../themes/cyberpunk/starship/cybrcore.toml
    );
  };
}
