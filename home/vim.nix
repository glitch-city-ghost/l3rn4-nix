{ config, pkgs, ... }:

let
  # Local generated theme from cyberpunk-palette.yaml
  # Generated by: generators/generate-vim-theme.py
  cyberpunk-vim = pkgs.vimUtils.buildVimPlugin {
    name = "cyberpunk-generated";
    src = ./themes/cyberpunk/vim;
  };
in
{
  programs.vim = {
    enable = true;
    plugins = with pkgs.vimPlugins; [
      cyberpunk-vim
      vim-airline
      nerdtree
    ];
    extraConfig = builtins.readFile ../vimrc;
  };
}