# ==========================================================
# l3rn4 :: btop theme :: cyberpunk
#
# Palette: theme/palette.yaml
# Canvas: base.bg, text: text.light, titles: text.main.
# Frames are one quiet violet (text.muted) so the hot pink and
# cyan accents read as highlights instead of a rainbow.
# Gradients follow the palette's semantics: cyan/blue = cool,
# green = headroom, yellow -> pink -> red = pressure.
# ==========================================================

# Base / text -------------------------------------------------
theme[main_bg]="@base.bg@"           # base.bg (canonical canvas)
theme[main_fg]="@text.light@"       # text.light
theme[title]="@text.main@"          # text.main (hot pink)
theme[hi_fg]="@accents.cyan@"       # accents.cyan

# Selection / muted -------------------------------------------
theme[selected_bg]="@surface.selection@"  # surface.selection
theme[selected_fg]="@text.light@"          # text.light
theme[inactive_fg]="@text.muted@"          # text.muted
theme[graph_text]="@text.muted@"           # text.muted
theme[meter_bg]="@surface.column_bg@"       # surface.column_bg

# Boxes: one quiet violet frame, pink titles -------------------
theme[proc_misc]="@accents.blue@"       # accents.blue
theme[cpu_box]="@text.muted@"           # text.muted
theme[mem_box]="@text.muted@"           # text.muted
theme[net_box]="@text.muted@"           # text.muted
theme[proc_box]="@text.muted@"          # text.muted
theme[div_line]="@surface.selection@"   # surface.selection

# Temperature: cool -> warm -> hot -----------------------------
theme[temp_start]="@accents.blue@"      # accents.blue
theme[temp_mid]="@accents.purple@"      # accents.purple
theme[temp_end]="@accents.red@"         # accents.red

# CPU: idle -> busy -> saturated -------------------------------
theme[cpu_start]="@accents.cyan@"       # accents.cyan
theme[cpu_mid]="@text.main@"            # text.main
theme[cpu_end]="@accents.red@"          # accents.red

# Memory / disk: free ------------------------------------------
theme[free_start]="@accents.teal@"      # accents.teal
theme[free_mid]="@accents.green@"       # accents.green
theme[free_end]="@accents.cyan@"        # accents.cyan

# Memory / disk: cached ----------------------------------------
theme[cached_start]="@surface.selection@"  # surface.selection
theme[cached_mid]="@text.heading@"          # text.heading
theme[cached_end]="@accents.purple@"        # accents.purple

# Memory / disk: available -------------------------------------
theme[available_start]="@accents.green@"  # accents.green
theme[available_mid]="@accents.cyan@"     # accents.cyan
theme[available_end]="@accents.blue@"     # accents.blue

# Memory / disk: used ------------------------------------------
theme[used_start]="@accents.yellow@"      # accents.yellow
theme[used_mid]="@accents.pink@"          # accents.pink
theme[used_end]="@accents.red@"           # accents.red

# Network: download (cool) -------------------------------------
theme[download_start]="@accents.blue@"    # accents.blue
theme[download_mid]="@accents.cyan@"      # accents.cyan
theme[download_end]="@accents.green@"     # accents.green

# Network: upload (warm) ---------------------------------------
theme[upload_start]="@accents.purple@"    # accents.purple
theme[upload_mid]="@accents.pink@"        # accents.pink
theme[upload_end]="@accents.red@"         # accents.red

# Process list gradient (1.4.x spelling: process_*) ------------
theme[process_start]="@text.muted@"       # text.muted (idle)
theme[process_mid]="@accents.pink@"       # accents.pink (busy)
theme[process_end]="@accents.red@"        # accents.red

# Process banners (btop >= 1.4) -------------------------------
theme[proc_pause_bg]="@surface.todo_bg@"       # surface.todo_bg
theme[proc_follow_bg]="@surface.search_bg@"    # surface.search_bg
theme[proc_banner_bg]="@surface.selection@"    # surface.selection
theme[proc_banner_fg]="@text.light@"           # text.light
theme[followed_bg]="@text.heading@"            # text.heading
theme[followed_fg]="@base.bg@"                 # base.bg
