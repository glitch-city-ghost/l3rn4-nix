# ==========================================================
# l3rn4 :: btop theme :: cyberpunk
# Pink-forward mapping of cyberpunk-palette.yaml.
# Base uses status_bg (@surface.status_bg@) and warmer pink tones.
# ==========================================================

# Base / text -------------------------------------------------
theme[main_bg]="@surface.status_bg@"          # surface.status_bg (pink-tinted dark)
theme[main_fg]="@text.light@"         # text.light
theme[title]="@text.main@"           # text.main (hot pink)
theme[hi_fg]="@accents.cyan@"           # accents.cyan

# Selection / muted -------------------------------------------
theme[selected_bg]="@text.main@"     # text.main (hot pink selection)
theme[selected_fg]="@base.bg@"     # base.bg
theme[inactive_fg]="@text.muted@"     # text.muted
theme[graph_text]="@accents.pink@"      # accents.pink
theme[meter_bg]="@surface.selection@"        # surface.selection

# Meters and boxes -------------------------------------------
theme[proc_misc]="@accents.pink@"       # accents.pink
theme[cpu_box]="@text.main@"         # text.main (hot pink)
theme[mem_box]="@accents.pink@"         # accents.pink
theme[net_box]="@accents.cyan@"         # accents.cyan
theme[proc_box]="@accents.red@"        # accents.red
theme[div_line]="@surface.selection@"        # surface.selection

# Temperatures: cool -> warm -> hot --------------------------
theme[temp_start]="@accents.cyan@"      # accents.cyan
theme[temp_mid]="@accents.yellow@"        # accents.yellow
theme[temp_end]="@accents.red@"        # accents.red

# CPU: pink at idle, red under load --------------------------
theme[cpu_start]="@accents.pink@"       # accents.pink
theme[cpu_mid]="@text.main@"         # text.main
theme[cpu_end]="@accents.red@"         # accents.red

# Memory / disk: free ----------------------------------------
theme[free_start]="@accents.cyan@"      # accents.cyan
theme[free_mid]="@accents.blue@"        # accents.blue
theme[free_end]="@accents.pink@"        # accents.pink

# Memory / disk: cached --------------------------------------
theme[cached_start]="@surface.selection@"    # surface.selection
theme[cached_mid]="@text.heading@"      # text.heading
theme[cached_end]="@accents.pink@"      # accents.pink

# Memory / disk: available -----------------------------------
theme[available_start]="@accents.green@" # accents.green
theme[available_mid]="@accents.cyan@"   # accents.cyan
theme[available_end]="@accents.pink@"   # accents.pink

# Memory / disk: used ----------------------------------------
theme[used_start]="@accents.yellow@"      # accents.yellow
theme[used_mid]="@accents.pink@"        # accents.pink
theme[used_end]="@accents.red@"        # accents.red

# Network: download ------------------------------------------
theme[download_start]="@accents.pink@"  # accents.pink
theme[download_mid]="@accents.purple@"    # accents.purple
theme[download_end]="@accents.cyan@"    # accents.cyan

# Network: upload --------------------------------------------
theme[upload_start]="@accents.pink@"    # accents.pink
theme[upload_mid]="@accents.yellow@"      # accents.yellow
theme[upload_end]="@accents.green@"      # accents.green

# Process list gradient (btop uses proc_*, not process_*) ---
theme[proc_start]="@accents.pink@"      # accents.pink
theme[proc_mid]="@text.main@"        # text.main (hot pink)
theme[proc_end]="@accents.yellow@"        # accents.yellow

# Process banners (btop >= 1.4) ------------------------------
theme[proc_pause_bg]="@accents.red@"    # accents.red
theme[proc_follow_bg]="@accents.cyan@"   # accents.cyan
theme[proc_banner_bg]="@surface.selection@"   # surface.selection
theme[proc_banner_fg]="@text.light@"   # text.light
theme[followed_bg]="@accents.pink@"      # accents.pink
theme[followed_fg]="@base.bg@"      # base.bg